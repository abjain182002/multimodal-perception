import json
import importlib.metadata as metadata
import torch
import mmdet3d
from mmcv.ops import nms

expected = {
    "torch": "2.1.2+cu121",
    "torchvision": "0.16.2+cu121",
    "numpy": "1.26.4",
    "setuptools": "69.5.1",
    "mmengine": "0.10.7",
    "mmcv": "2.1.0",
    "mmdet": "3.2.0",
    "nuscenes-devkit": "1.2.0",
    "spconv-cu120": "2.3.6",
}
for package, version in expected.items():
    actual = metadata.version(package)
    assert actual == version, (package, actual, version)

boxes = torch.tensor(
    [[0., 0., 1., 1.], [0., 0., 1., 1.]], device="cuda"
)
scores = torch.tensor([0.9, 0.8], device="cuda")
_, keep = nms(boxes, scores, 0.5)
assert keep.cpu().tolist() == [0]
torch.cuda.synchronize()

print(json.dumps({
    "status": "MMDET3D_DEPENDENCIES_AND_MMCV_GPU_PASS",
    "versions": expected,
    "gpu": torch.cuda.get_device_name(0),
    "nms_keep": keep.cpu().tolist(),
    "scope": "Core dependencies checked; BEVFusion custom operations pending."
}, indent=2), flush=True)

{
  "status": "MMDET3D_DEPENDENCIES_AND_MMCV_GPU_PASS",
